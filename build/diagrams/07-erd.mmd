        text idempotency_key UK
        text submitted_by FK
        integer created_at
    }
    ATTACHMENTS {
        text id PK
        text submission_id FK
        text original_name
        text stored_key UK
        text mime_type
        integer size_bytes
        text checksum_sha256
        text state "PENDING | COMMITTED"
        text uploaded_by FK
        integer created_at
    }
    TASK_REVIEWS {
        text id PK
        text submission_id FK
        text reviewer_id FK
        text decision "APPROVED | REVISION_REQUIRED"
        text feedback
        integer created_at
    }
    DOCUMENT_ARCHIVE {
        text id PK
        text assignment_id FK
        text submission_id FK
        text task_id FK
        text division_id FK
        text title
        integer archived_at
    }
    NOTIFICATIONS {
        text id PK
        text user_id FK
        text type
        text entity_type
        text entity_id
        text message
        integer read_at
        integer created_at
    }
    NOTIFICATION_DELIVERIES {
        text id PK
        text notification_id FK
        text channel "EMAIL | WHATSAPP"
        text status "PENDING | SENDING | SENT | FAILED"
        integer attempts
        integer next_attempt_at
        text last_error
        text provider_ref
        integer sent_at
    }
    NOTIFICATION_PREFERENCES {
        text user_id FK
        text channel "EMAIL | WHATSAPP"
        integer enabled
    }
    OTP_CODES {
        text id PK
        text user_id FK
        text target
        text purpose "WA_VERIFY"
        text code_hash
        integer attempts
        integer expires_at
        integer consumed_at
        integer created_at
    }
    EMAIL_CHANGE_REQUESTS {
        text id PK
        text user_id FK
        text new_email
        text token_hash UK
        integer expires_at
        integer consumed_at
        integer created_at

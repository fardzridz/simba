        text default_priority "RENDAH | SEDANG | TINGGI | MENDESAK"
        integer is_active
        integer created_at
    }
    USERS {
        text id PK
        text division_id FK
        text username UK
        text email UK
        integer email_verified_at
        text nip UK
        text position
        text wa_number UK
        integer wa_verified_at
        text full_name
        text password_hash

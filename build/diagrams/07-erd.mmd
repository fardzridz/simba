        integer last_login_at
        integer created_at
        integer updated_at
    }
    CATEGORIES {
        text id PK
        text name UK
        integer is_active
        integer created_at
    }
    TASKS {
        text id PK
        text division_id FK
        text category_id FK
        text task_number UK
        text title
        text description
        text priority "RENDAH | SEDANG | TINGGI | MENDESAK"
        text created_by FK
        integer start_at
        integer due_at
        integer cancelled_at
        text cancel_reason
        integer created_at
        integer updated_at
    }
